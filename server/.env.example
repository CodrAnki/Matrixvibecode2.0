# Copy to .env and fill in. This file lists variable NAMES only — never commit real values.
# Everything here is backend-only. The frontend only ever receives VITE_API_URL (see ../.env.example).

PORT=5000
NODE_ENV=development            # set to "production" on deployed servers

# --- Required ---
MONGODB_URI=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (min 32 chars in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Required in production ---
CLIENT_URL=                     # frontend origin(s), comma-separated for several
PUBLIC_APP_URL=                 # base URL used to build QR check-in links
# OTP email via Gmail SMTP. SMTP_PASSWORD must be a Google App Password (never the normal account password).
# SMTP_FROM must equal SMTP_USER; any other address is ignored and SMTP_USER is used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ankitdubey.matrix@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ankitdubey.matrix@gmail.com

# --- Deployment tuning (optional) ---
TRUST_PROXY=                    # number of reverse-proxy hops (e.g. 1). Needed so rate limits count real client IPs.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2

# --- OTP (optional; defaults shown) ---
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Seed script only (never hardcode in source) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# When false/unset a SUPER_ADMIN can only create plain ADMIN accounts.
ALLOW_SUPER_ADMIN_CREATION=false

# --- Contact form -> WhatsApp notification (Meta WhatsApp Cloud API). Optional. ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
